{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Format avec Prettier",
            "type": "shell",
            "command": "npx",
            "args": ["prettier", "--write", "resources/"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Blade Formatter",
            "type": "shell",
            "command": "npx",
            "args": ["blade-formatter", "--write", "resources/views/"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Laravel Artisan",
            "type": "shell",
            "command": "php",
            "args": ["artisan"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Regenerate IDE Helper",
            "type": "shell",
            "command": "php",
            "args": ["artisan", "ide-helper:generate", "&&", "php", "artisan", "ide-helper:models", "--reset", "--write", "&&", "php", "artisan", "ide-helper:meta"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
